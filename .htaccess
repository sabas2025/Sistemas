ServerSignature Off
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|config|database|storage|vendor|contracts|tests|scripts|workers|audit|docs|node_modules)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "\.(env|ini|log|sql|bak|backup|zip|tar|gz|7z|key|pem|md|txt|csv)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

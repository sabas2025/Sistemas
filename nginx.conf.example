# Reauditoria 2026-09-14: todo o hardening HTTP deste projeto (bloqueio de app/config/database/
# storage, extensões sensíveis, workers via navegador, headers de segurança) estava implementado
# SOMENTE em .htaccess (public/.htaccess e .htaccess da raiz). Isso não tem efeito nenhum em
# ambientes Nginx - o .htaccess é ignorado silenciosamente e nada disso é aplicado. Este arquivo
# é o equivalente para quem hospeda em Nginx + PHP-FPM. Ajuste os caminhos e o socket/porta do
# PHP-FPM antes de usar. Ele não substitui public/.htaccess/.htaccess (que continuam necessários
# para hospedagens Apache/cPanel) - é uma configuração alternativa completa para Nginx.

# ---------------------------------------------------------------------------
# OPÇÃO RECOMENDADA: aponte o document root do site para a pasta public/ deste
# projeto (não para a raiz). Com isso, app/, config/, database/, storage/, contracts/,
# tests/, scripts/, workers/ e docs/ ficam FORA do webroot e nem precisam de regra de
# bloqueio: o Nginx simplesmente não tem como servir o que está fora do root.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name SEU_DOMINIO_AQUI;

    root /caminho/para/o/projeto/public;   # raiz = pasta public/, não a raiz do projeto
    index index.php;

    ssl_certificate     /caminho/para/fullchain.pem;
    ssl_certificate_key /caminho/para/privkey.pem;

    server_tokens off;

    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), bluetooth=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Extensões que nunca devem ser servidas como arquivo estático, mesmo dentro de public/.
    location ~* \.(env|ini|log|sql|bak|backup|zip|tar|gz|7z|key|pem|json)$ {
        deny all;
        return 404;
    }

    # Workers não podem ser executados pelo navegador (mesma regra do public/.htaccess).
    # Cada worker_*.php já se autoprotege em PHP com PHP_SAPI!=='cli' - isto é defesa em
    # profundidade para o caso de o guard em PHP falhar ou ser removido por engano.
    location ~* ^/worker.*\.php$ {
        deny all;
        return 404;
    }

    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;   # ajuste para o socket/porta do seu PHP-FPM
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}

server {
    listen 80;
    server_name SEU_DOMINIO_AQUI;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# FALLBACK: use os location blocks abaixo DENTRO do server{} acima somente se a
# hospedagem obrigar o document root a ser a RAIZ do projeto (não public/), replicando
# o .htaccess da raiz. Prefira sempre a opção com root=public/ quando possível.
# ---------------------------------------------------------------------------
#    location ~ ^/(app|config|database|storage|vendor|contracts|tests|scripts|workers|audit|docs|node_modules)(/|$) {
#        deny all;
#        return 404;
#    }
#    location ~* \.(env|ini|log|sql|bak|backup|zip|tar|gz|7z|key|pem|md|txt|csv)$ {
#        deny all;
#        return 404;
#    }
